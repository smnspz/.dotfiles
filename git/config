[user]
  name = Simone Rosani
  email = rsn.smn@gmail.com

[url "git@github.com:"]
  insteadOf = https://github.com/

[url "git@gitlab.com:"]
  insteadOf = https://gitlab.com/

[push]
  autoSetupRemote = true

[core]
  autocrlf = input
  pager = bat

[init]
  defaultBranch = main

[alias]
  dd = !git diff --name-only --relative --diff-filter=d | xargs bat --diff

[rerere]
  enabled = true

# It's possible to include a custom git configuration based on the working directory. For example: 
# [includeif "gitdir/i:/your/work/directory"]
#  path = /path/to/your/work/git/config

[column]
  ui = auto

[branch]
  sort = committerdate

[merge]
  tool = vimdiff
